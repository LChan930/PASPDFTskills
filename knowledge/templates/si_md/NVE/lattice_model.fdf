# Si native PW-MD; actual source geometry is the local include below.
Model DFT
%include siesta.ANI

%block pseudo_pot_files
Si.pz-vbc.UPF
%endblock pseudo_pot_files

# Gamma only (default k mesh); no speculative k/band pool splitting (1/1).
# Common 20 Ha starting cutoff; convergence remains untested.
DFT.ENCUT 20 Hartree
DFT.ALGO 6 # Retain source Davidson choice.
DFT.EDIFF 1.0d-8
DFT.mixing 0.3

# The mass default is 1 amu, NOT the element mass. Species order: Si.
%block DFT.MASS
28.086
%endblock DFT.MASS

DFT.LMD T
PW_MD.ensemble 1 # 1 NVE, 2 NVT, 3 NPH, 4 NPT
PW_MD.solver 1 # Match ensemble-effective integrator (1 Verlet / 2 Beeman).
PW_MD.thermostat 1
PW_MD.dt 0.5 # fs
PW_MD.nstep 400 # Updates; expect step 0 through N.
# No initial-velocity block: retain source zero-temperature start.
# NVE retains source thermostat=1 request; ensemble=1 sets its damping to zero.
PW_MD.velocity_temp 0.0 # K; motion begins from displaced Si geometry.
