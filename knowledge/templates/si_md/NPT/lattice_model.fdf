# Si native PW-MD; actual source geometry is the local include below.
Model DFT
%include siesta.ANI

%block pseudo_pot_files
Si.pz-vbc.UPF
%endblock pseudo_pot_files

# Gamma only (default k mesh); no speculative k/band pool splitting (1/1).
# Common 20 Ha starting cutoff; convergence remains untested.
DFT.ENCUT 20 Hartree
DFT.ALGO 6 # Retain source Davidson choice.
DFT.EDIFF 1.0d-7
DFT.mixing 0.3

# The mass default is 1 amu, NOT the element mass. Species order: Si.
%block DFT.MASS
28.086
%endblock DFT.MASS

DFT.LMD T
PW_MD.ensemble 4 # 1 NVE, 2 NVT, 3 NPH, 4 NPT
PW_MD.solver 2 # Match ensemble-effective integrator (1 Verlet / 2 Beeman).
PW_MD.thermostat 4
PW_MD.dt 1.0 # fs
PW_MD.nstep 4000 # Updates; expect step 0 through N.
# No initial-velocity block: retain source zero-temperature start.
PW_MD.barostat 1 # Parrinello-Rahman, ensemble-effective choice.
PW_MD.PMASS 400.0 # amu cell inertia, retained source value.
PW_MD.pressure 40.0 # GPa; high-pressure demonstration.
PW_MD.temperature 1.0d-8 # K: near-zero-T source, not finite-T benchmark.
PW_MD.tolp 1.0d-8 # K
PW_MD.nraise 40
